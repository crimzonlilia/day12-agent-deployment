# ============================================================
# .env.example — Copy thành .env và điền giá trị thật
# ❌ KHÔNG commit file .env lên Git!
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=false

# ── App ─────────────────────────────────────────────────────
APP_NAME=My Production Agent
APP_VERSION=1.0.0

# ── LLM ─────────────────────────────────────────────────────
# Để trống → dùng Mock LLM (không cần key thật)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Security — BẮT BUỘC thay trong production ────────────────
AGENT_API_KEY=my-secret-api-key-change-this
JWT_SECRET=my-jwt-secret-change-this

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=10

# ── Cost guard ───────────────────────────────────────────────
MONTHLY_BUDGET_USD=10.0

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Conversation history ─────────────────────────────────────
MAX_HISTORY_MESSAGES=20
HISTORY_TTL_SECONDS=86400

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=*
